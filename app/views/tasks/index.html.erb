<h1>Task Management System</h1>

<%= link_to "Create New Task", new_task_path %>

<hr>

<% @tasks.each do |task| %>

  <h3><%= task.name %></h3>

  <p>
    Status: <%= task.status %>
  </p>

  <p>
    Priority: <%= task.priority %>
  </p>

  <%= link_to "View", task_path(task) %>

  <%= link_to "Edit", edit_task_path(task) %>

  <%= link_to "Delete",
      task_path(task),
      data: {
        turbo_method: :delete,
        turbo_confirm: "Are you sure?"
      } %>

  <hr>

<% end %>
